# Copy to .env.local and fill in.

# RevenueCat public SDK key for Android (Project settings → API keys in RevenueCat).
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# URL of the deployed role-play server (see server/), e.g. https://naao-roleplay.onrender.com
EXPO_PUBLIC_ROLEPLAY_URL=
# Must match APP_TOKEN on the server.
EXPO_PUBLIC_ROLEPLAY_TOKEN=

# Set to 1 only for test builds: shows a "Preview: unlock premium" button on the paywall.
EXPO_PUBLIC_TEST_MODE=
